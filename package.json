{
  "name": "financial-servicing-ledger-api",
  "version": "1.0.0",
  "description": "Financial servicing ledger API - paid technical test",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "migrate": "node-pg-migrate --tsx --envPath .env",
    "migrate:test": "node-pg-migrate --tsx --envPath .env.test",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration --pool=forks --poolOptions.forks.singleFork",
    "test": "npm run test:unit && npm run test:integration"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "node-pg-migrate": "^7.6.1",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  }
}
